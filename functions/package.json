{
  "name": "gongura-griha-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Gongura Griha",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "serve": "firebase emulators:start --only functions",
